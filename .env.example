# Local secrets for agent_playbook_ai_api ingestion — DO NOT COMMIT the real .env
# Copy this file to `.env` and fill in the value. `.env` is gitignored.
#
# deploy_sync.sh loads `.env` and pushes CONFLUENCE_TOKEN into the dedicated
# Databricks secret scope `agent_playbook_scope` (key: confluence-token),
# which ingest.py / sync.py read at runtime. We intentionally do NOT reuse
# another project's scope (e.g. asset_api_scope).

# Confluence Cloud API token (Basic auth, owner = CONFLUENCE_USER).
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_TOKEN=
